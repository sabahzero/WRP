# What factors influence my happiness?
pdata <- read.csv("Personal-Data_pcoa.csv") # Need numeric for PCoA, and no 0s
# Log transform
pdata.log <- log(pdata[1:7])
# Bray-Curtis statistics
pdata.bray <- vegdist(pdata.log, "bray")
res <- pcoa(pdata.bray)
res$values
# Plot
biplot(res)
biplot(res, pdata.log, scaling = "symmetric", type = c("text", "points"))
